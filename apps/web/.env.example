# ————— Supabase —————
# Supabase Dashboard → Project Settings → API
#
# هذان المفتاحان عامان بطبيعتهما ويظهران في كود الصفحة — وهذا تصميمهما.
# الصلاحيات لا تأتي منهما بل من سياسات RLS داخل القاعدة (supabase/schema.sql):
# الزائر يقرأ المحتوى فقط، والكتابة كلها محصورة في بريد المالك.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ لا تضع service_role key هنا ولا في أي ملف داخل المشروع.
#    هذا المفتاح يتجاوز كل سياسات الحماية، ووضعه في موقع static يعني
#    تسليم القاعدة كاملة لأي زائر.

# ————— بريد المالك —————
# للعرض في الواجهة فقط. الحارس الحقيقي دالة owner_email() داخل Postgres،
# فتغييره هنا وحده لا يمنح أحدًا أي صلاحية.
NEXT_PUBLIC_OWNER_EMAIL=masry5357@gmail.com

# ————— مسار الموقع على GitHub Pages —————
# مستودع باسم المشروع:      /<repo>     مثال: /elmagd
# مستودع <user>.github.io:  اتركه فارغًا
# نطاق خاص:                 اتركه فارغًا
# ملف النشر .github/workflows/deploy.yml يضبطه تلقائيًا، وهذا للتشغيل المحلي.
NEXT_PUBLIC_BASE_PATH=
